<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyTitle>PostmarkDotNet</AssemblyTitle>
    <PackageProjectUrl>https://github.com/CloudPaperGroup/postmark-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CloudPaperGroup/postmark-dotnet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>CloudPaperGroup.PostmarkDotNet</PackageId>
    <AssemblyName>Postmark</AssemblyName>
    <Version>5.4.1.1</Version>
    <Company>Cloud Paper Group Pty Ltd</Company>
    <Authors>ActiveCampaign; CloudPaperGroup</Authors>
    <Copyright>Copyright (c) 2012 ActiveCampaign. Changes copyright (c) 2026 Cloud Paper Group Pty Ltd.</Copyright>
    <Description>CloudPaperGroup fork of Postmark.NET 5.4.1 with JsonFix: works in apps that turn reflection-based System.Text.Json off. Based on ActiveCampaign's Postmark.NET library (MIT). Not an official Postmark package.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.Json" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>